{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Turbo Code Palette Snippet metadata",
  "allOf": [{ "$ref": "./common.schema.json#/definitions/base" }],
  "type": "object",
  "required": ["sources"],
  "additionalProperties": true,
  "properties": {
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Existing files relative to the Snippet folder; runtime additionally checks containment, portable names, links and limits." },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name"], "additionalProperties": true,
        "properties": {
          "id": { "$ref": "./common.schema.json#/definitions/uuid" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1, "description": "Optional AND-only comparisons (=, >, >=, <, <=) against canonical TCP versions. Omission means any; malformed or empty constraints fail closed." }
        }
      }
    },
    "insert": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "defaultMode": { "type": "string" },
        "allowedModes": { "$ref": "./common.schema.json#/definitions/strings" },
        "deniedModes": { "$ref": "./common.schema.json#/definitions/strings" },
        "targets": { "$ref": "./common.schema.json#/definitions/strings" }
      }
    },
    "templateVariables": {
      "type": "array", "items": {
        "type": "object", "required": ["name"], "additionalProperties": true,
        "properties": { "name": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" }, "default": { "type": "string" }, "options": { "$ref": "./common.schema.json#/definitions/strings" } }
      }
    },
    "exports": {
      "type": "array", "items": {
        "type": "object", "required": ["kind", "name"], "additionalProperties": true,
        "properties": { "kind": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "container": { "type": "string" }, "namespace": { "type": "string" }, "signature": { "type": "string" } }
      }
    }
  }
}
