{
  "name": "turbo-code-palette",
  "displayName": "Turbo Code Palette",
  "description": "A fast, visual snippet palette designed to supercharge competitive programming workflows.",
  "version": "0.0.1",
  "publisher": "oz-coden",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Snippets"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "turbo-code-palette.reloadCatalog",
        "title": "Turbo Code Palette: Reload Library",
        "icon": "$(refresh)"
      },
      {
        "command": "turbo-code-palette.searchCatalog",
        "title": "Turbo Code Palette: Search Snippets",
        "icon": "$(search)"
      },
      {
        "command": "turbo-code-palette.openDropTarget",
        "title": "Turbo Code Palette: Open Phase 0 Drop Target"
      },
      {
        "command": "turbo-code-palette.insertDemo",
        "title": "Insert Demo Snippet"
      },
      {
        "command": "turbo-code-palette.previewDemo",
        "title": "Preview Demo Snippet"
      },
      {
        "command": "turbo-code-palette.showDiagnostics",
        "title": "Turbo Code Palette: Show Phase 0 Diagnostics"
      },
      { "command": "turbo-code-palette.searchPacks", "title": "Turbo Code Palette: Search Packs", "icon": "$(search)" },
      { "command": "turbo-code-palette.details", "title": "Turbo Code Palette: Show Details" },
      { "command": "turbo-code-palette.edit", "title": "Turbo Code Palette: Edit Metadata", "icon": "$(edit)" },
      { "command": "turbo-code-palette.newSnippet", "title": "Turbo Code Palette: New Snippet", "icon": "$(add)" },
      { "command": "turbo-code-palette.createSelection", "title": "Turbo Code Palette: Create Snippet from Selection" },
      { "command": "turbo-code-palette.createFile", "title": "Turbo Code Palette: Create Snippet from Current File" },
      { "command": "turbo-code-palette.createPack", "title": "Turbo Code Palette: Create Pack", "icon": "$(add)" },
      { "command": "turbo-code-palette.copyWorkspace", "title": "Turbo Code Palette: Copy to Workspace" },
      { "command": "turbo-code-palette.copyGlobal", "title": "Turbo Code Palette: Copy to Global" },
      { "command": "turbo-code-palette.delete", "title": "Turbo Code Palette: Delete", "icon": "$(trash)" },
      { "command": "turbo-code-palette.favorite", "title": "Turbo Code Palette: Toggle Favorite", "icon": "$(star-empty)" },
      { "command": "turbo-code-palette.filter", "title": "Turbo Code Palette: All / Favorites / Recent", "icon": "$(filter)" },
      { "command": "turbo-code-palette.insert", "title": "Turbo Code Palette: Insert Snippet", "shortTitle": "Default Mode", "icon": "$(arrow-right)" },
      { "command": "turbo-code-palette.insertWithMode", "title": "Turbo Code Palette: Insert Snippet with Mode…", "shortTitle": "Choose Mode…" },
      { "command": "turbo-code-palette.upgrade", "title": "Turbo Code Palette: Upgrade Metadata Format" },
      { "command": "turbo-code-palette.openGlobalFolder", "title": "Turbo Code Palette: Open Global Library Folder" },
      { "command": "turbo-code-palette.revealGlobalFolder", "title": "Turbo Code Palette: Reveal Global Library" },
      { "command": "turbo-code-palette.configureGlobalRoot", "title": "Turbo Code Palette: Configure Global Root" },
      { "command": "turbo-code-palette.reviewRecovery", "title": "Turbo Code Palette: Review Interrupted Save" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "turbo-code-palette",
          "title": "Turbo Code Palette",
          "icon": "media/palette.svg"
        }
      ]
    },
    "views": {
      "turbo-code-palette": [
        {
          "id": "turbo-code-palette.snippets",
          "name": "Snippets"
        },
        { "id": "turbo-code-palette.packs", "name": "Packs" },
        {
          "id": "turbo-code-palette.demos",
          "name": "Development Insertion Demos",
          "when": "tcp.showDemos"
        }
      ]
    },
    "submenus": [{ "id": "tcp.insertMenu", "label": "Insert" }],
    "menus": {
      "tcp.insertMenu": [
        { "command": "turbo-code-palette.insert", "group": "1_insert@1" },
        { "command": "turbo-code-palette.insertWithMode", "group": "1_insert@2" }
      ],
      "view/title": [
        {
          "command": "turbo-code-palette.openDropTarget",
          "when": "view == turbo-code-palette.demos",
          "group": "navigation"
        },
        { "command": "turbo-code-palette.searchCatalog", "when": "view == turbo-code-palette.snippets", "group": "navigation@1" },
        { "command": "turbo-code-palette.newSnippet", "when": "view == turbo-code-palette.snippets", "group": "navigation@2" },
        { "command": "turbo-code-palette.searchPacks", "when": "view == turbo-code-palette.packs", "group": "navigation@1" },
        { "command": "turbo-code-palette.createPack", "when": "view == turbo-code-palette.packs", "group": "navigation@2" },
        { "command": "turbo-code-palette.reloadCatalog", "when": "view == turbo-code-palette.snippets || view == turbo-code-palette.packs", "group": "navigation@3" },
        { "command": "turbo-code-palette.filter", "when": "view == turbo-code-palette.snippets || view == turbo-code-palette.packs", "group": "navigation@4" },
        { "command": "turbo-code-palette.openGlobalFolder", "when": "view == turbo-code-palette.packs", "group": "library@1" },
        { "command": "turbo-code-palette.revealGlobalFolder", "when": "view == turbo-code-palette.packs", "group": "library@2" },
        { "command": "turbo-code-palette.configureGlobalRoot", "when": "view == turbo-code-palette.packs", "group": "library@3" }
      ],
      "view/item/context": [
        {
          "command": "turbo-code-palette.insertDemo",
          "when": "view == turbo-code-palette.demos && viewItem == tcp.phase0.snippet",
          "group": "inline"
        },
        {
          "command": "turbo-code-palette.insertDemo",
          "when": "view == turbo-code-palette.demos && viewItem == tcp.phase0.snippet",
          "group": "1_insert"
        },
        { "command": "turbo-code-palette.insert", "when": "viewItem == tcp.snippet", "group": "inline@1" },
        { "submenu": "tcp.insertMenu", "when": "viewItem == tcp.snippet", "group": "1_insert" },
        { "command": "turbo-code-palette.edit", "when": "viewItem == tcp.snippet || viewItem == tcp.pack", "group": "2_edit@1" },
        { "command": "turbo-code-palette.favorite", "when": "viewItem == tcp.snippet || viewItem == tcp.pack", "group": "2_edit@2" },
        { "command": "turbo-code-palette.copyWorkspace", "when": "(viewItem == tcp.snippet || viewItem == tcp.pack) && tcp.hasWorkspace", "group": "3_copy@1" },
        { "command": "turbo-code-palette.copyGlobal", "when": "viewItem == tcp.snippet || viewItem == tcp.pack", "group": "3_copy@2" },
        { "command": "turbo-code-palette.delete", "when": "viewItem == tcp.snippet || viewItem == tcp.pack", "group": "4_delete" }
      ],
      "editor/context": [
        { "command": "turbo-code-palette.createSelection", "when": "editorHasSelection", "group": "tcp@1" },
        { "command": "turbo-code-palette.createFile", "group": "tcp@2" }
      ]
    },
    "configuration": {
      "title": "Turbo Code Palette",
      "properties": {
        "turboCodePalette.globalRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute Global library directory on the extension host. Empty uses extension storage. Open/Reveal Global Library or Configure Global Root makes these assets accessible. Reload explicitly after changing the root."
        },
        "turboCodePalette.showDevelopmentDemos": {
          "type": "boolean", "default": false,
          "description": "Show historical Phase 0 text demonstration commands (reload window required). Product Snippets use the shared insertion pipeline."
        },
        "turboCodePalette.previewBeforeInsert": {
          "type": "boolean",
          "default": false,
          "description": "Preview the complete insertion plan before applying. Cancelling changes no target or output files. Native drag and drop is retired; use Insert."
        }
      }
    },
    "jsonValidation": [
      { "fileMatch": "**/snippet.json", "url": "./schemas/snippet.schema.json" },
      { "fileMatch": "**/pack.json", "url": "./schemas/pack.schema.json" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "node scripts/compile-tests.mjs",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && node --test out/test/unit/*.test.js scripts/public-repo-rules.test.mjs",
    "test:host": "npm run compile-tests && npm run compile && node scripts/run-host-tests.mjs",
    "dev:host": "npm run compile && node scripts/launch-dev-host.mjs",
    "check-public": "node scripts/check-public-repo.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
