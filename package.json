{
  "name": "turbo-code-palette",
  "displayName": "Turbo Code Palette",
  "description": "A fast, visual snippet palette designed to supercharge competitive programming workflows.",
  "version": "0.0.1",
  "publisher": "oz-coden",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Snippets"
  ],
  "extensionKind": ["workspace"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "turbo-code-palette.openUxLab",
        "title": "Turbo Code Palette: Open D&D UX Lab (Research)"
      },
      {
        "command": "turbo-code-palette.showUxLabDiagnostics",
        "title": "Turbo Code Palette: Show D&D UX Lab Diagnostics"
      },
      {
        "command": "turbo-code-palette.openDropTarget",
        "title": "Turbo Code Palette: Open Phase 0 Drop Target"
      },
      {
        "command": "turbo-code-palette.insertDemo",
        "title": "Insert Demo Snippet"
      },
      {
        "command": "turbo-code-palette.previewDemo",
        "title": "Preview Demo Snippet"
      },
      {
        "command": "turbo-code-palette.showDiagnostics",
        "title": "Turbo Code Palette: Show Phase 0 Diagnostics"
      }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "turbo-code-palette", "title": "Turbo Code Palette", "icon": "media/palette.svg" }]
    },
    "views": {
      "turbo-code-palette": [
        { "id": "turbo-code-palette.snippets", "name": "Snippets (Phase 0)" },
        { "id": "turbo-code-palette.uxNative", "name": "UX Lab Native", "when": "tcp.uxLab" },
        { "id": "turbo-code-palette.uxCards", "name": "UX Lab Cards", "type": "webview", "when": "tcp.uxLab" }
      ]
    },
    "menus": {
      "view/title": [{ "command": "turbo-code-palette.openDropTarget", "when": "view == turbo-code-palette.snippets", "group": "navigation" }],
      "view/item/context": [{ "command": "turbo-code-palette.insertDemo", "when": "view == turbo-code-palette.snippets && viewItem == tcp.phase0.snippet", "group": "inline" }]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && node --test out/test/unit/*.test.js scripts/public-repo-rules.test.mjs",
    "test:host": "npm run compile-tests && npm run compile && node scripts/run-host-tests.mjs",
    "dev:host": "npm run compile && node scripts/launch-dev-host.mjs",
    "dev:ux": "npm run compile && node scripts/launch-dev-host.mjs --ux-lab",
    "dev:ux:min": "npm run compile && node scripts/launch-dev-host.mjs --ux-lab --minimum",
    "check-public": "node scripts/check-public-repo.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
